# Free key from https://www.eia.gov/opendata/register.php (instant, no approval wait).
# Without it, the app falls back to a fixed baseline price for the simulated stations.
EXPO_PUBLIC_EIA_API_KEY=

# Google Cloud API key with "Places API (New)" enabled (requires billing enabled
# on the project, though usage should stay within the monthly free credit for
# personal use). Gives real per-station, per-fuel-type prices when set -- this
# takes priority over everything else. See README for setup steps.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
